# Python virtual environments
.venv/
venv/
env/

# Python caches
__pycache__/
*.py[cod]
*$py.class

# macOS metadata
.DS_Store

# Jupyter notebook state
.ipynb_checkpoints/
**/.ipynb_checkpoints/

# Raw data and generated results
# Keep the data directory structure, but exclude large/local artifacts.
data/raw/*.csv
data/interim/*.csv
data/processed/*.csv
data/predictions/*.csv

# Trained models
models/*.pkl
models/*.joblib

# Generated reports and figures
reports/figures/*.png
reports/figures/*.jpg
reports/figures/*.jpeg
reports/figures/*.pdf

# Test and coverage output
.pytest_cache/
.coverage
htmlcov/
