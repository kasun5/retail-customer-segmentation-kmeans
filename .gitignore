# Python virtual environments
.venv/
venv/
env/

# Python caches
__pycache__/
*.py[cod]
*$py.class

# macOS metadata
.DS_Store

# Jupyter notebook state
.ipynb_checkpoints/
**/.ipynb_checkpoints/

# Raw data and generated results
# Keep the data directory structure, but exclude large/local artifacts.
data/raw/*
!data/raw/.gitkeep

data/interim/*
!data/interim/.gitkeep

data/processed/*
!data/processed/.gitkeep

data/predictions/*
!data/predictions/.gitkeep

# Trained models
models/*
!models/.gitkeep

# Generated reports and figures
reports/*
!reports/figures/
reports/figures/*
!reports/figures/.gitkeep

# Test and coverage output
.pytest_cache/
.coverage
htmlcov/
